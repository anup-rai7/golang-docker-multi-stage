# Single-Stage Docker Build (Traditional Approach)
# This Dockerfile shows the traditional approach:
# - Includes all build tools and dependencies in final image
# - Much larger image size
# - Potential security risks from unnecessary tools

FROM golang:1.21

# Set working directory
WORKDIR /app

# Copy source code
COPY app.go .

# Build the application
RUN go build -o app app.go

# Expose port
EXPOSE 8080

# Set environment variables
ENV ENVIRONMENT=production
ENV DOCKER=true

# Run the application
ENTRYPOINT ["./app"]